# Turso Database Configuration
# Obtain these from: turso db show <db-name> --url  and  turso db tokens create <db-name>
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# Secret key required in the Authorization header by /api/ingest
# e.g., Authorization: Bearer <INGEST_SECRET>
INGEST_SECRET=your-super-secret-token-change-me

# Optional: Port for local server (defaults to 3000)
PORT=3000
