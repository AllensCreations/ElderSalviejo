{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/week/:slug*",
      "destination": "/week"
    },
    {
      "source": "/mission-call",
      "destination": "/call"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
